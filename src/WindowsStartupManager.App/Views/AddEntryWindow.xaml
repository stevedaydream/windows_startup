<Window x:Class="WindowsStartupManager.App.Views.AddEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Startup Entry" Height="280" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Source" Grid.Row="0" Margin="0,0,0,4" />
        <ComboBox x:Name="SourceComboBox" Grid.Row="1" Margin="0,0,0,8" SelectedIndex="0">
            <ComboBoxItem Content="Registry (Current User)" Tag="CurrentUserRegistryRun" />
            <ComboBoxItem Content="Registry (All Users)" Tag="LocalMachineRegistryRun" />
            <ComboBoxItem Content="Startup Folder (Current User)" Tag="CurrentUserStartupFolder" />
            <ComboBoxItem Content="Startup Folder (All Users)" Tag="CommonStartupFolder" />
        </ComboBox>

        <TextBlock Text="Name" Grid.Row="2" Margin="0,0,0,4" />
        <TextBox x:Name="NameTextBox" Grid.Row="3" Margin="0,0,0,8" />

        <StackPanel Grid.Row="4" VerticalAlignment="Top">
            <TextBlock Text="Command" Margin="0,0,0,4" />
            <DockPanel>
                <Button Content="Browse..." DockPanel.Dock="Right" Click="BrowseButton_Click" Padding="8,2" Margin="8,0,0,0" />
                <TextBox x:Name="CommandTextBox" />
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" Margin="0,0,8,0" Click="OkButton_Click" IsDefault="True" />
            <Button Content="Cancel" Width="80" Click="CancelButton_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>