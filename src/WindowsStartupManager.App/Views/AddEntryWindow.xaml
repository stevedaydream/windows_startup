<Window x:Class="WindowsStartupManager.App.Views.AddEntryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="Add Startup Entry" Width="580" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="White">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,22"><TextBlock Text="Add startup entry" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Start an application automatically when you sign in." Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
  <Label Grid.Row="1" Content="_Source" Target="{Binding ElementName=SourceComboBox}" Padding="0,0,0,6"/>
  <StackPanel Grid.Row="2" Margin="0,0,0,18">
   <ComboBox x:Name="SourceComboBox" SelectedIndex="0" AutomationProperties.Name="Startup source">
    <ComboBoxItem Content="Registry (Current User)" Tag="CurrentUserRegistryRun"/>
    <ComboBoxItem Content="Registry (All Users)" Tag="LocalMachineRegistryRun"/>
    <ComboBoxItem Content="Startup Folder (Current User)" Tag="CurrentUserStartupFolder"/>
    <ComboBoxItem Content="Startup Folder (All Users)" Tag="CommonStartupFolder"/>
   </ComboBox>
   <TextBlock Text="All Users sources require administrator access." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/>
  </StackPanel>
  <Label Grid.Row="3" Content="_Name" Target="{Binding ElementName=NameTextBox}" Padding="0,0,0,6"/>
  <TextBox x:Name="NameTextBox" Grid.Row="4" Margin="0,0,0,18" AutomationProperties.Name="Entry name"/>
  <Label Grid.Row="5" Content="_Command" Target="{Binding ElementName=CommandTextBox}" Padding="0,0,0,6"/>
  <StackPanel Grid.Row="6">
   <DockPanel><Button Content="_Browse…" DockPanel.Dock="Right" Click="BrowseButton_Click" Margin="10,0,0,0"/><TextBox x:Name="CommandTextBox" AutomationProperties.Name="Startup command"/></DockPanel>
   <TextBlock Text="Choose a file, or enter a quoted path with optional arguments." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/>
  </StackPanel>
  <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0"><Button Content="Cancel" MinWidth="90" Click="CancelButton_Click" IsCancel="True" Margin="0,0,10,0"/><Button Content="Add entry" MinWidth="110" Style="{StaticResource PrimaryButton}" Click="OkButton_Click" IsDefault="True"/></StackPanel>
 </Grid>
</Window>
